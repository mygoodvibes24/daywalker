; Engine configuration file.
config_version=5

[application]

config/name="Daywalker: Blood and Moon"
config/description="Open-world action-horror prototype. A daywalker against vampires and werewolves."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

Settings="*res://scripts/settings.gd"
Audio="*res://scripts/audio/audio.gd"
Dialogue="*res://scripts/audio/dialogue.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
textures/vram_compression/import_etc2_astc=true
